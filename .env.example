# ─── Mode ────────────────────────────────────────────────────────────────
# local  = clone repo, jalankan di komputer sendiri
# cloud  = Vercel + TiDB Cloud + domain pribadi (default otomatis di Vercel)
APP_MODE=local
# URL publik aplikasi, mis. https://daily-report.lumelo.my.id
APP_URL=http://localhost:3000
# Opsional: domain khusus login & OAuth, mis. https://daily-report.vercel.app.
# Halaman login dan callback Basecamp berjalan di sini, lalu pengguna dikembalikan ke APP_URL.
AUTH_URL=
# true = tanpa halaman login (satu pengguna). Hanya berlaku di mode lokal.
SINGLE_USER=true
# Siapa yang boleh membuat akun: * = siapa saja, atau email/@domain dipisah koma.
# Kosong = hanya akun pertama (pemilik).
SIGNUP_ALLOWED_EMAILS=
# Admin (pemilik) yang melihat panduan pendaftaran OAuth di /connect: email dipisah koma.
# Kosong = akun tertua. Mode SINGLE_USER: pengguna lokal.
ADMIN_EMAILS=
# Kuota per pengguna (default di bawah). Penting bila pendaftaran dibuka untuk umum.
# QUOTA_AI_PER_DAY=30
# QUOTA_REPORTS_PER_DAY=50
# QUOTA_JOBS_PER_HOUR=60
# QUOTA_STORAGE_MB=200

# ─── Database (MySQL 8 / TiDB) ───────────────────────────────────────────
DATABASE_URL=mysql://root:root@127.0.0.1:3306/report_tool
# TiDB Cloud: mysql://<prefix>.daily_report:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/daily_report
# TLS otomatis aktif untuk host tidbcloud.com; isi true/false untuk memaksa.
DATABASE_SSL=

# ─── Storage gambar/PDF ──────────────────────────────────────────────────
# local = folder STORAGE_PATH | vercel-blob = Vercel Blob privat (default di Vercel) | s3 = R2/S3
STORAGE_DRIVER=local
# vercel-blob: hubungkan Blob store (Private) ke project; di luar Vercel isi BLOB_READ_WRITE_TOKEN
STORAGE_PATH=./storage
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=report-tool
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Job queue ───────────────────────────────────────────────────────────
# local = runner di proses yang sama (di Vercel lewat after()/waitUntil) | qstash = Upstash QStash
QUEUE_DRIVER=local
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# Rahasia untuk worker yang memanggil /api/jobs/:type secara langsung
JOBS_SECRET=

# ─── Screenshot & PDF ────────────────────────────────────────────────────
# local-worker = worker Python Playwright (folder worker/) | remote-worker | none (default di Vercel)
BROWSER_DRIVER=local-worker
BROWSER_WORKER_URL=http://127.0.0.1:3100
# Harus sama dengan WORKER_TOKEN di worker (kosongkan di lokal bila tidak perlu)
BROWSER_WORKER_TOKEN=

# ─── Basecamp (daftarkan integrasi di https://launchpad.37signals.com/integrations)
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
# Default: <AUTH_URL atau APP_URL>/api/connectors/basecamp/callback
BASECAMP_REDIRECT_URI=http://localhost:3000/api/connectors/basecamp/callback
# Wajib oleh Basecamp: nama aplikasi + email kontak
BASECAMP_USER_AGENT=Daily Report (you@example.com)

# ─── Connector kanban lain (isi yang mau diaktifkan; Redirect URI tampil di halaman Koneksi)
# Trello (https://trello.com/power-ups/admin → API key; tambahkan domain login ke Allowed origins)
TRELLO_API_KEY=
# GitHub OAuth App (https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Jira Cloud (https://developer.atlassian.com/console/myapps/ → OAuth 2.0 integration)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Linear (https://linear.app/settings/api/applications/new)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# ClickUp (https://app.clickup.com/settings/apps)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# ─── Webhook satu klik ───────────────────────────────────────────────────
# Discord (https://discord.com/developers/applications → OAuth2 Redirects)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slack (https://api.slack.com/apps → scope incoming-webhook, Public Distribution)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── AI penyusun draf ────────────────────────────────────────────────────
# Tiap pengguna bisa "Connect OpenRouter" sendiri di halaman Koneksi (tanpa pengaturan di sini).
# Variabel di bawah adalah AI bawaan instalasi untuk pengguna yang belum menghubungkan AI-nya.
# anthropic | openai | none (none = draf disusun dari step & komentar tanpa AI)
AI_PROVIDER=anthropic
AI_API_KEY=
# Kosongkan untuk default provider (anthropic: claude-sonnet-5-5). Wajib untuk openai.
AI_MODEL=

# ─── Keamanan ────────────────────────────────────────────────────────────
# 32 byte base64. Buat dengan: npm run gen:key
ENCRYPTION_KEY=
